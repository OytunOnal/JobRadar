# SQLite for local dev. Swap for a Postgres/Supabase URL later.
DATABASE_URL="file:./dev.db"

# Optional: enables LLM fit analysis + cover-letter drafting.
# Get a free key at https://console.groq.com
# NOTE: Groq free tier is ~100k tokens/day PER MODEL. Don't share one key across
# apps (e.g. hodeFX) or you'll exhaust the daily budget — give JobRadar its own.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"        # cover letters (stronger model)
GROQ_FIT_MODEL="llama-3.1-8b-instant"       # fit scoring (cheap/fast, separate daily limit)

# --- Aggregator APIs for LinkedIn / Indeed / Glassdoor coverage (optional) ---
# These are the ONLY sustainable way to pull the big three — they index
# Google-for-Jobs / many boards. Free tiers exist. Wire the connectors once set.
#
# Adzuna (free dev key, strong EU coverage + salary): https://developer.adzuna.com
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# JSearch via RapidAPI (free tier; Google-for-Jobs = LinkedIn/Indeed/Glassdoor/ZipRecruiter):
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=""
