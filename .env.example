# Copy to .env and fill in what you have. Only DATABASE_URL is required.

# Local SQLite (default). Swap for a Postgres URL if you deploy.
DATABASE_URL="file:./dev.db"

# ─── LLM providers (bring your own key) ──────────────────────────────────────
# At least one key enables LLM fit scoring + cover-letter drafting.
# Without any, JobRadar still works with keyword-only scoring.
# Providers are tried in this order; on rate-limit/error the next takes over.

# 1) Anthropic (recommended primary — best judgment quality; fit costs ~cents).
#    Key: https://console.anthropic.com
ANTHROPIC_API_KEY=""
# fast tier — bulk fit triage (hundreds of jobs, cents): keep this cheap
ANTHROPIC_FAST_MODEL="claude-haiku-4-5"
# strong tier — cover letters + the dashboard's per-job Analyze-fit button.
# Quality-critical but tiny volume (~2¢ a letter on Opus), so use a top model;
# set it to claude-haiku-4-5 instead if you want everything on the cheap tier.
ANTHROPIC_MODEL="claude-opus-4-8"

# 2) Cerebras (optional fallback — generous free tier, very fast).
#    Key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=""

# 3) Groq (optional fallback — free tier, ~100k tokens/day per model).
#    Key: https://console.groq.com
GROQ_API_KEY=""

# 4) Google Gemini (optional fallback). Key: https://aistudio.google.com
GOOGLE_API_KEY=""

# 5) DeepSeek (optional fallback, paid). Key: https://platform.deepseek.com
DEEPSEEK_API_KEY=""

# ─── Job aggregator APIs (optional — big coverage boost) ─────────────────────
# These index thousands of boards, including LinkedIn/Indeed/Glassdoor listings
# (via Google for Jobs). Both have free tiers; sources are skipped without keys.

# Adzuna (strong EU coverage + salary data): https://developer.adzuna.com
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# Optional tuning (defaults shown): countries + search queries, comma-separated
# ADZUNA_COUNTRIES="gb,de,nl"
# ADZUNA_QUERIES="unity developer,game developer,ai engineer,full stack developer"

# JSearch via RapidAPI (Google for Jobs): subscribe free at
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=""
# JSEARCH_QUERIES="unity developer remote,ai engineer remote europe,full stack developer remote europe"

# LinkedIn via Apify (free plan ships ~$5/mo credit; ~1$/1k results)
# APIFY_API_TOKEN=
# LINKEDIN_TITLES=unity developer,llm engineer
# LINKEDIN_LOCATIONS=European Union,Turkey
# LINKEDIN_MAX_ITEMS=150
