{
  "name": "jobradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/init-config.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "discovery:audit": "tsx scripts/discovery-audit.ts",
    "discovery:validate": "tsx --env-file=.env scripts/discover-validate.ts",
    "discovery:crawl": "tsx --env-file=.env scripts/discover-crawl.ts",
    "fit:batch": "tsx --env-file=.env scripts/fit-batch.ts",
    "test": "node --import tsx --test tests/score.test.ts tests/fit.test.ts tests/discovery.test.ts tests/harvest.test.ts tests/validate.test.ts tests/crawl.test.ts tests/pool.test.ts tests/freshness.test.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
