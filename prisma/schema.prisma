generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A company's board on an ATS platform, found by the discovery layer (or seeded
// by hand). Boards start as `candidate`; a validation probe against the ATS API
// promotes them to `active` or marks them `dead` (rechecked every 30 days).
model AtsBoard {
  id            Int       @id @default(autoincrement())
  platform      String    // registry id in src/lib/discovery/platforms.ts
  token         String    // the board slug, canonical form
  region        String    @default("") // e.g. "eu" when found on a regional host
  companyName   String?
  status        String    @default("candidate") // candidate | active | dead
  discoveredVia String    // seed | harvest | commoncrawl | wayback | hf-dataset
  validatedAt   DateTime?
  lastFetchedAt DateTime?
  // Fraction of this board's jobs that pass the keyword threshold; drives
  // adaptive fetch frequency (irrelevant boards get fetched less often).
  hitRate           Float @default(0)
  fetchIntervalDays Int   @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([platform, token, region])
  @@index([status])
}

// Learned location knowledge: raw location strings the gazetteer couldn't
// place, resolved once by a batched LLM call and remembered forever.
// Editable by hand; a null country means "asked, couldn't tell".
// Name-guess probe memory (harvest tier 4): company names we already tried
// to map to an ATS board by slugifying and probing. found=false entries are
// remembered so a name is never probed twice.
model CompanyProbe {
  id          Int      @id @default(autoincrement())
  name        String   @unique // normalized company name
  displayName String? // original spelling, for the tier-5 website lookup
  found       Boolean  @default(false)
  // Tier 5 (website -> careers-page scan) already attempted for this name.
  deepChecked Boolean  @default(false)
  website     String? // domain the LLM resolved (kept even on a miss)
  createdAt   DateTime @default(now())
}

model LocationCache {
  id         Int      @id @default(autoincrement())
  raw        String   @unique // normalized location string
  country    String? // ISO alpha-2
  resolvedBy String   @default("llm")
  createdAt  DateTime @default(now())
}

model Job {
  id          String   @id @default(cuid())
  // Stable identity across ingests: source + the source's own id, hashed.
  dedupeKey   String   @unique
  source      String
  externalId  String
  url         String
  title       String
  company     String
  location    String?
  remote      Boolean  @default(false)
  // ISO alpha-2, resolved from the location string (gazetteer → cache →
  // batched LLM). null = no location (remote) or unresolved.
  country     String?
  // remote | hybrid | onsite — explicit from the source when it says so,
  // else derived from the posting text. `remote` stays as the boolean the
  // region filter keys on (hybrid is location-bound, NOT remote).
  workMode    String   @default("onsite")
  salaryText  String?
  description String

  // Cross-source identity: normalized title+company, used to collapse the same
  // role coming in from multiple sources.
  contentKey  String   @default("")

  // Ranking trust: 2 = direct ATS, 1 = curated boards, 0 = mass aggregators.
  sourceTrust Int      @default(1)

  // Scoring
  score       Int      @default(0)
  track       String?  // unity | playable | ai | fullstack | other
  scoreReason String?
  scoredBy    String?  // keyword | llm

  // LLM fit analysis (CV vs job description) — filled on demand.
  fitScore    Int?
  fitVerdict  String?  // strong | possible | weak
  fitComment  String?
  fitCategory String?  // why weak: NO_VISA | LANGUAGE | PROFILE | OTHER (NONE otherwise)
  // Posting reads like an evergreen/talent-pool ad, per the fit analysis.
  ghostRisk   Boolean  @default(false)

  // Visa sponsorship signal: yes | no | unknown. Free text heuristic at
  // ingest; the LLM fit pass upgrades unknown -> no on an explicit refusal.
  visa        String   @default("unknown")
  // Company appears in its country's public sponsor register (see VisaSponsor).
  sponsorReg  Boolean  @default(false)

  // Set when the LLM semantic dedup confirms this row is the same opportunity
  // as an existing one (repost / reworded / per-city listing). The row stays so
  // identity dedupe recognizes the source id, but it never renders on the board.
  duplicateOfId String?

  // Application pipeline
  status      String   @default("new") // new | interested | applied | interview | rejected | offer | ignored
  coverLetter String?
  notes       String?

  postedAt    DateTime?
  // Pool-diff freshness: when OUR system first/last saw this job listed.
  // Source-reported postedAt lies on evergreen boards (Lever createdAt from
  // 2019); "wasn't in the pool yesterday, is today" does not.
  // Cold-start caveat: rows existing before this column got firstSeenAt at
  // migration time — don't trust firstSeenAt older than the migration date.
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  // Stamped by the ingest sweep the moment a direct-source job disappears
  // from its board's feed; cleared if it reappears. Kills the dead-link
  // window the 14-day pool-advance grace would otherwise leave open.
  delistedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([score])
  @@index([contentKey])
}

// Public visa-sponsor registers (the complete set of European countries that
// publish one): NL IND recognised sponsors, UK Home Office licensed Worker
// sponsors, DK SIRI fast-track certified companies, IE employment-permit
// holders. Matching a job's company against its country's register is a
// COMPANY-level signal ("licensed to sponsor"), independent of what the
// posting text says.
model VisaSponsor {
  id        Int      @id @default(autoincrement())
  country   String   // iso2: nl | gb | dk | ie
  name      String
  nameNorm  String   // normalized + collapsed for matching
  detail    String?  // route/type info from the register
  updatedAt DateTime @default(now())

  @@index([country, nameNorm])
}

// Per-source fetch timestamps, so heavy/rate-sensitive sources (LinkedIn's
// 103-search matrix) keep their weekly cadence even when ingest runs more
// often. Sources without a cooldown entry run every ingest.
model SourceState {
  name          String   @id
  lastFetchedAt DateTime
}
