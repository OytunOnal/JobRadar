generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A company's board on an ATS platform, found by the discovery layer (or seeded
// by hand). Boards start as `candidate`; a validation probe against the ATS API
// promotes them to `active` or marks them `dead` (rechecked every 30 days).
model AtsBoard {
  id            Int       @id @default(autoincrement())
  platform      String    // registry id in src/lib/discovery/platforms.ts
  token         String    // the board slug, canonical form
  region        String    @default("") // e.g. "eu" when found on a regional host
  companyName   String?
  status        String    @default("candidate") // candidate | active | dead
  discoveredVia String    // seed | harvest | commoncrawl | wayback | hf-dataset
  validatedAt   DateTime?
  lastFetchedAt DateTime?
  // Fraction of this board's jobs that pass the keyword threshold; drives
  // adaptive fetch frequency (irrelevant boards get fetched less often).
  hitRate           Float @default(0)
  fetchIntervalDays Int   @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([platform, token, region])
  @@index([status])
}

// Learned location knowledge: raw location strings the gazetteer couldn't
// place, resolved once by a batched LLM call and remembered forever.
// Editable by hand; a null country means "asked, couldn't tell".
// Name-guess probe memory (harvest tier 4): company names we already tried
// to map to an ATS board by slugifying and probing. found=false entries are
// remembered so a name is never probed twice.
model CompanyProbe {
  id          Int      @id @default(autoincrement())
  name        String   @unique // normalized company name
  displayName String? // original spelling, for the tier-5 website lookup
  found       Boolean  @default(false)
  // Tier 5 (website -> careers-page scan) already attempted for this name.
  deepChecked Boolean  @default(false)
  website     String? // domain the LLM resolved (kept even on a miss)
  createdAt   DateTime @default(now())
}

model LocationCache {
  id         Int      @id @default(autoincrement())
  raw        String   @unique // normalized location string
  country    String? // ISO alpha-2
  resolvedBy String   @default("llm")
  createdAt  DateTime @default(now())
}

model Job {
  id          String   @id @default(cuid())
  // Stable identity across ingests: source + the source's own id, hashed.
  dedupeKey   String   @unique
  source      String
  externalId  String
  url         String
  title       String
  company     String
  location    String?
  remote      Boolean  @default(false)
  // ISO alpha-2, resolved from the location string (gazetteer → cache →
  // batched LLM). null = no location (remote) or unresolved.
  country     String?
  // remote | hybrid | onsite — explicit from the source when it says so,
  // else derived from the posting text. `remote` stays as the boolean the
  // region filter keys on (hybrid is location-bound, NOT remote).
  workMode    String   @default("onsite")
  salaryText  String?
  // description moved to JobContent (layered split) — the hot row carries
  // only what list rendering and sorting need.

  // Cross-source identity: normalized title+company, used to collapse the same
  // role coming in from multiple sources.
  contentKey  String   @default("")

  // Ranking trust: 2 = direct ATS, 1 = curated boards, 0 = mass aggregators.
  sourceTrust Int      @default(1)

  // Scoring
  score       Int      @default(0)
  track       String?  // unity | playable | ai | fullstack | other
  scoreReason String?
  scoredBy    String?  // keyword | llm

  // LLM fit analysis (CV vs job description) — filled on demand.
  fitScore    Int?
  // Which lane produced the fit verdict (null = first-pass cloud/8b chain;
  // "qwen27b-review" = the deep local second pass).
  fitBy       String?
  fitVerdict  String?  // strong | possible | weak
  fitComment  String?
  fitCategory String?  // why weak: NO_VISA | LANGUAGE | PROFILE | OTHER (NONE otherwise)
  // Posting reads like an evergreen/talent-pool ad, per the fit analysis.
  ghostRisk   Boolean  @default(false)

  // Visa sponsorship signal: yes | no | unknown. Free text heuristic at
  // ingest; the LLM fit pass upgrades unknown -> no on an explicit refusal.
  visa        String   @default("unknown")
  // Company appears in its country's public sponsor register (see VisaSponsor).
  sponsorReg  Boolean  @default(false)
  // Who established the posting-level visa signal: regex (ingest heuristic) |
  // source (a board's structured flag) | llm (the model read the posting).
  // Strength order llm > source > regex — a weaker layer never overwrites a
  // stronger one. Same provenance pattern as scoredBy/seniorityBy/fitBy.
  visaBy      String?
  // DERIVED from visa + visaBy + sponsorReg + source + the profile's work
  // authorization: not-needed | yes | maybe | no | unknown. Stored (not
  // computed per query) because the radar filters and the fit queue sort on
  // it over half a million rows. Every write goes through applyVisaEvidence()
  // and `npm run doctor` audits the invariant.
  visaTier    String   @default("unknown")
  // Application tracking (the /applied page): when it was applied to, the
  // next follow-up nudge, and a free-form note.
  appliedAt   DateTime?
  followUpAt  DateTime?
  note        String?
  // Why the user dismissed it (status "ignored") — doubles as labeled feedback
  // for tuning the scorer (e.g. many "language" dismissals => detect language
  // requirements automatically).
  dismissReason String?

  // Store-all: gate-rejected jobs are kept (flagged) instead of dropped, so
  // scorer fixes are a local re-score away and gate mistakes stay auditable.
  disqualified Boolean @default(false)
  // embedding moved to JobEmbedding (layered split).

  // Set when the LLM semantic dedup confirms this row is the same opportunity
  // as an existing one (repost / reworded / per-city listing). The row stays so
  // identity dedupe recognizes the source id, but it never renders on the board.
  duplicateOfId String?

  // Application pipeline (current-state projection; history in UserActionLog)
  status      String   @default("new") // new | interested | applied | interview | rejected | offer | ignored
  // coverLetter moved to JobContent (layered split).
  notes       String?

  postedAt    DateTime?
  // Pool-diff freshness: when OUR system first/last saw this job listed.
  // Source-reported postedAt lies on evergreen boards (Lever createdAt from
  // 2019); "wasn't in the pool yesterday, is today" does not.
  // Cold-start caveat: rows existing before this column got firstSeenAt at
  // migration time — don't trust firstSeenAt older than the migration date.
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  // Stamped by the ingest sweep the moment a direct-source job disappears
  // from its board's feed; cleared if it reappears. Kills the dead-link
  // window the 14-day pool-advance grace would otherwise leave open.
  delistedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Seniority v2: the structured level extracted from the posting
  // (junior|mid|senior|staff|management|unknown) and which layer decided it
  // ("detector" regex vs "llm" — the 27B verdict overrides the detector).
  seniorityLevel String?
  seniorityBy    String?
  // Language requirements detected in the description (comma-separated ISO
  // codes, e.g. "de") — precomputed so the radar never reads JobContent.
  langReq        String?

  content   JobContent?
  vector    JobEmbedding?
  facts     PostingFacts?
  listings  JobListingHistory[]
  scores    KeywordScoreHistory[]
  judgments LlmJudgmentHistory[]
  actions   UserActionLog[]

  @@index([status])
  @@index([score])
  @@index([contentKey])
  // The radar's hot path: candidates only, newest verdicts first.
  @@index([disqualified, status, delistedAt, fitScore])
  @@index([country])
  @@index([postedAt])
  @@index([lastSeenAt]) // poolNewest max() and freshness windows
  @@index([visaTier])
}

// ── Layered architecture (see docs/ARCHITECTURE.md) ──────────────────────────
// Naming convention: ...History = append-only record, never overwritten;
// ...Log = user/event stream; ...Snapshot = computed summary, reproducible.
// Job stays the thin hot core; its score/fit/status columns are CURRENT-value
// projections of the history tables below (CQRS-lite: SQLite sorts want the
// current value on the hot row).

// CV-INDEPENDENT extractions about the POSTING itself: what level is this
// role, which languages does it demand, does it offer sponsorship, does it
// smell like a ghost ad. These are facts about the text, so they stay valid
// when the user edits their CV — unlike fit judgments, which must then be
// redone. Hence a 1:1 current-value table (re-extract overwrites) rather than
// a history: the posting didn't change, only our extractor might improve,
// which extractorVersion records.
model PostingFacts {
  jobId            String  @id
  job              Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  visaOffered      String? // yes | no | null (posting silent)
  seniorityLevel   String? // intern|junior|mid|senior|staff|management|unknown
  langReq          String? // comma-separated ISO codes required by the posting
  ghostRisk        Boolean @default(false)
  model            String
  extractorVersion String
  at               DateTime @default(now())
}

// Fat text, split from Job so list scans never page through 8KB descriptions
// (measured: ~10KB rows made every filter click scan gigabytes).
model JobContent {
  jobId       String  @id
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  description String
  contentHash String  @default("")
  coverLetter String?
  // HOW this text was produced, not what it says. Same convention as
  // SCORER_VERSION / FIT_PROMPT_VERSION / EXTRACTOR_VERSION: a refresh is
  // "fill where the version is behind", which makes a pool-wide re-fetch
  // resumable and idempotent instead of a job that must run to completion.
  //
  // The version that matters right now is the one before this field existed:
  // text written by the old stripHtml, which collapsed every newline and so
  // destroyed the section structure at ingest. Half the pool carries it.
  textVersion String?
}

// Embedding vector, split even from JobContent: the queue builder reads ALL
// vectors sequentially — a dense small table beats picking blobs out of text
// pages. `model` guards against silently mixing vector spaces.
model JobEmbedding {
  jobId  String @id
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  model  String
  vector Bytes
}

// "This job was listed at this source at this time." Written on STATE CHANGES
// only (listed/delisted/relisted), not every sweep — freshness projections
// live on Job; repost/ghost detection reads the history.
model JobListingHistory {
  id     Int      @id @default(autoincrement())
  jobId  String
  job    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source String
  event  String // listed | delisted | relisted
  at     DateTime @default(now())

  @@index([jobId])
}

// Every keyword-scorer verdict, tagged with the scorer version that produced
// it. A re-score is "fill where version < current" — and "what did v4 wrongly
// kill" becomes a query instead of an archaeology dig.
model KeywordScoreHistory {
  id            Int      @id @default(autoincrement())
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  scorerVersion String
  score         Int
  track         String?
  reason        String?
  disqualified  Boolean  @default(false)
  at            DateTime @default(now())

  @@index([jobId])
}

// Every LLM fit judgment — appended, never overwritten. The 27B-vs-8B
// calibration measurement (29% optimism) was only possible while both values
// briefly coexisted; this table makes such comparisons permanent.
model LlmJudgmentHistory {
  id             Int      @id @default(autoincrement())
  jobId          String
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  model          String // qwen27b | 8b-era | groq/... (provenance)
  promptVersion  String
  fitScore       Int
  verdict        String
  category       String?
  seniorityLevel String?
  ghostRisk      Boolean  @default(false)
  comment        String?
  at             DateTime @default(now())

  @@index([jobId])
}

// User intent as an event stream: applied / dismissed(reason) / starred /
// status changes / notes. Current status stays projected on Job (UI queries
// unchanged); the log is what made dismissal-pattern analysis possible.
model UserActionLog {
  id      Int      @id @default(autoincrement())
  jobId   String?
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  type    String // status-change | dismissed | restored | note | follow-up | applied
  payload String? // small JSON: {"from":"new","to":"applied"} / {"reason":"language"}
  at      DateTime @default(now())

  @@index([jobId])
}

// Ingest-end counter snapshot: the stat strip and facet headers read ONE row
// instead of group-by'ing half a million.
model DashboardStatsSnapshot {
  id    Int      @id @default(autoincrement())
  at    DateTime @default(now())
  stats String // JSON: totals, counts by status/verdict/track/country
}

// Public visa-sponsor registers (the complete set of European countries that
// publish one): NL IND recognised sponsors, UK Home Office licensed Worker
// sponsors, DK SIRI fast-track certified companies, IE employment-permit
// holders. Matching a job's company against its country's register is a
// COMPANY-level signal ("licensed to sponsor"), independent of what the
// posting text says.
model VisaSponsor {
  id        Int      @id @default(autoincrement())
  country   String   // iso2: nl | gb | dk | ie
  name      String
  nameNorm  String   // normalized + collapsed for matching
  detail    String?  // route/type info from the register
  updatedAt DateTime @default(now())

  @@index([country, nameNorm])
}

// Per-source fetch timestamps, so heavy/rate-sensitive sources (LinkedIn's
// 103-search matrix) keep their weekly cadence even when ingest runs more
// often. Sources without a cooldown entry run every ingest.
model SourceState {
  name          String   @id
  lastFetchedAt DateTime
}
